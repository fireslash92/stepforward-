; Engine configuration file.
; Open this folder in Godot 4.3 or newer (works with the latest 4.x).

config_version=5

[application]

config/name="Step Forward If You Have"
config/description="Online 3D party game: one Question Master asks, everyone else steps forward or stays."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
